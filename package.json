{
  "name": "afresh-modeling",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "dev:backend": "npm run dev --prefix onyxx-backend",
    "dev:all": "concurrently -n next,api -c blue,magenta \"npm run dev\" \"npm run dev --prefix onyxx-backend\"",
    "build": "next build",
    "build:backend": "npm run build --prefix onyxx-backend",
    "start": "node scripts/start.mjs",
    "lint": "next lint",
    "icons": "powershell -ExecutionPolicy Bypass -File scripts/generate-pwa-icons.ps1",
    "android:update": "npx @bubblewrap/cli@latest update --manifest android/twa-manifest.json",
    "android:build": "npx @bubblewrap/cli@latest build --manifest android/twa-manifest.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.174.0",
    "chart.js": "^4.4.8",
    "cloudinary": "^2.5.1",
    "jose": "^6.2.2",
    "next": "^15.2.4",
    "pg": "^8.20.0",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
    "sass": "^1.85.1",
    "three": "^0.174.0",
    "typescript": "^5.8.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.2.4"
  }
}
