# =============================================================================
# Next.js frontend (repo root) — local dev + DigitalOcean *web* app
# =============================================================================

# Web server port (DigitalOcean sets PORT=8080 automatically in production)
PORT=8080

# Node API base URL — no trailing slash. MUST be your *backend* app URL when split-deployed.
# Server-side admin actions use BASE_URL; the apply form uses NEXT_PUBLIC_BASE_URL in the browser.
BASE_URL=https://your-api.ondigitalocean.app
NEXT_PUBLIC_BASE_URL=https://your-api.ondigitalocean.app

# Public marketing site URL (emails, links). Your *frontend* URL / custom domain — not the API host.
# PUBLIC_SITE_URL=https://afreshmodeling.com

# Same value as JWT_SECRET in onyxx-backend/.env (admin cookie verification after login).
JWT_SECRET=use-a-long-random-string
# ADMIN_SESSION_SECRET=use-a-long-random-string

# Optional: direct Postgres from Next (hire-models admin fallback if API route missing).
# Use the same DATABASE_URL as the API when enabling this.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Cloudinary (admin upload proxies + signatures)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=afresh

# Local dev (two terminals or `npm run dev:all`):
# BASE_URL=http://127.0.0.1:4000
# NEXT_PUBLIC_BASE_URL=http://127.0.0.1:4000
